# =============================================================
#  PORTFOLIO FRONTEND — ENVIRONMENT VARIABLES
#  Copy to ".env" for local dev. On Vercel, set these in the
#  project's Environment Variables UI.
#  Only variables prefixed with VITE_ are exposed to the browser.
# =============================================================

# Base URL of the backend API (NO trailing slash, include /api)
# Local:      http://localhost:5000/api
# Production: https://your-portfolio-api.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Fallback canonical origin only. The real one is Admin -> Settings -> SEO -> Site URL, which wins at
# runtime so a domain change needs no code edit or redeploy; this is used until that value has loaded.
VITE_SITE_URL=http://localhost:5173
