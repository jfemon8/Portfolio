# =============================================================
#  PORTFOLIO BACKEND — ENVIRONMENT VARIABLES
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env file (it is git-ignored).
#  Step-by-step instructions: see /docs for each service.
# =============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# Fallback canonical origin for sitemap.xml and robots.txt, used only until Admin -> Settings -> SEO ->
# Site URL is set (that value wins). Defaults to the first CLIENT_URL entry, which is a CORS allow-list
# and may hold several origins, so set this explicitly when they differ.
SITE_URL=http://localhost:5173

# ---- MongoDB Atlas ----  (docs/01-MONGODB-ATLAS-SETUP.md)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- JWT Auth ----  (docs/07-ADMIN-AND-SEEDING.md)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_64_byte_hex_string
# Short-lived access token — the client silently refreshes it via the
# httpOnly cookie, so this can stay short without logging anyone out.
JWT_EXPIRES_IN=15m

# ---- Initial Admin Account (used by the seed script) ----
ADMIN_NAME=Md Jannatul Ferdhous Emon
ADMIN_EMAIL=jfemon8@gmail.com
ADMIN_PASSWORD=ChangeThisStrongPassword!123

# ---- Cloudinary (image uploads) ----  (docs/02-CLOUDINARY-SETUP.md)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=portfolio

# ---- Email / SMTP (contact-form notifications) ----  (docs/03-EMAIL-SMTP-SETUP.md)
# For Gmail use an "App Password" (NOT your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jfemon8@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
# Where contact-form messages are delivered:
CONTACT_RECEIVER_EMAIL=jfemon8@gmail.com

# ---- Automated jobs ingestion ----
# A 16+ character value shared with Vercel Cron. Set this in Vercel, never commit a real value.
CRON_SECRET=replace_with_a_long_random_cron_secret
# JSON array of approved public RSS, JSON, or Lever feeds. Only HTTPS public feeds are accepted.
# Leave it unset to use the built-in reviewed Bangladesh sources.
# Set to [] to disable automatic sources, or replace it with reviewed feeds:
# [{"key":"company-careers","name":"Company Careers","url":"https://example.com/jobs.json","format":"json","category":"it"}]
# Lever feeds can restrict imported postings to Bangladesh-declared locations:
# [{"key":"company-bd","name":"Company Bangladesh","url":"https://api.lever.co/v0/postings/company?mode=json","format":"lever","category":"it","bangladeshOnly":true}]
# Lookback in Bangladesh calendar days for postings that state no deadline (0-90, default 30).
# A posting whose deadline is still in the future is always imported, however old it is.
JOB_SYNC_LOOKBACK_DAYS=30
# Validity applied when a posting states no deadline; a stated deadline always overrides it.
JOB_DEFAULT_VALIDITY_DAYS=30
#
# Least-privilege credential for the ingestion agent. Leave unset and the agent
# uses MONGODB_URI, which can reach every collection. To restrict it, create an
# Atlas custom role and a user that holds only that role, then put its URI here:
#
#   Role name: jobsAgent
#   Actions on collection "jobs":             find, insert, update, remove
#   Actions on collection "jobsourcehealths": find, insert, update, remove
#   (No other collection is granted, so users/tokens/messages stay unreachable.)
#
# JOBS_AGENT_MONGODB_URI=mongodb+srv://jobs_agent:password@cluster/portfolio?retryWrites=true&w=majority
# Automated listings unseen by any feed for this many days are deleted (0 disables, default 45).
JOB_RETENTION_DAYS=45
