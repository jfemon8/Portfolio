# =============================================================
#  PORTFOLIO BACKEND — ENVIRONMENT VARIABLES
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env file (it is git-ignored).
#  Step-by-step instructions: see /docs for each service.
# =============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas ----  (docs/01-MONGODB-ATLAS-SETUP.md)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- JWT Auth ----  (docs/07-ADMIN-AND-SEEDING.md)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ---- Initial Admin Account (used by the seed script) ----
ADMIN_NAME=Md Jannatul Ferdhous Emon
ADMIN_EMAIL=jfemon8@gmail.com
ADMIN_PASSWORD=ChangeThisStrongPassword!123

# ---- Cloudinary (image uploads) ----  (docs/02-CLOUDINARY-SETUP.md)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=portfolio

# ---- Email / SMTP (contact-form notifications) ----  (docs/03-EMAIL-SMTP-SETUP.md)
# For Gmail use an "App Password" (NOT your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jfemon8@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
# Where contact-form messages are delivered:
CONTACT_RECEIVER_EMAIL=jfemon8@gmail.com
