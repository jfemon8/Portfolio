{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 60 }
    }
  ],
  "crons": [{ "path": "/api/jobs/cron", "schedule": "45 17 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.ts" }]
}
